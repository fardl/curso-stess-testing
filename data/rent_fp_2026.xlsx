<script>
$(function () {

    const modalEl = document.getElementById('enlace-interesmodal');
    const modal = new bootstrap.Modal(modalEl);

    $(".enlace-interesmodal").on("click", function (e) {
        e.preventDefault();
        modal.show();
    });

    $("#closemodale").on("click", function () {
        modal.hide();
    });

    // 🔥 Cerrar al hacer clic fuera del contenido
    $('#enlace-interesmodal').on('click', function (e) {
        if ($(e.target).hasClass('modal')) {
            modal.hide();
        }
    });

});
</script>
