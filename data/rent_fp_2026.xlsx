    <section class="pb-5" style="background-color:#f7f7f7; min-height:100vh;">
        <div class="container mb-5">

            
            
            <h2 class="fw-semibold mb-3" style="color:#343A40;">
                Fondos de Pensiones 2026
            </h2>

            
            
            
            
            
            
                            <div class="mt-4" aria-label="Listado de documentos">
                    <div class="row g-3">

                                                    
                            <div class="col-12 col-md-4">
                                <a href="https://www.sipen.gob.do/descarga/fondos-de-pensiones-2026_2026_04_1776098520.xlsx" target="_blank" rel="noopener" class="text-decoration-none d-block h-100 card-link-hover" aria-label="Descargar documento Valor Cuota de los Fondos de Pensiones">

                                    <div class="card shadow-sm border-0 rounded-4 p-3 h-100">
                                        <div class="d-flex flex-column h-100">

                                            
                                                                                            <small class="text-muted mb-2">
                                                    31/03/2026
                                                </small>
                                            
                                            
                                            <h6 class="fw-semibold text-dark mb-3">
                                                Valor Cuota de los Fondos de Pensiones
                                            </h6>

                                            
                                            <div class="mt-auto d-flex align-items-center gap-2">

                                                <div class="flex-box  br-ocho mr-diez items-v-center">
                                                    <span class="">
                                                        
                                                        <img src="https://www.sipen.gob.do/img/iconos/xlsx.png" width="30px" alt="Descargar">
                                                    </span>
                                                    

                                                </div>


                                                                                                    <small class="text-muted">
                                                        (0.06
                                                        MB)
                                                    </small>
                                                                                            </div>

                                        </div>
                                    </div>
                                </a>
                            </div>
                                                    
                            <div class="col-12 col-md-4">
                                <a href="https://www.sipen.gob.do/descarga/fondos-de-pensiones-2026_2026_04_1776098553.xlsx" target="_blank" rel="noopener" class="text-decoration-none d-block h-100 card-link-hover" aria-label="Descargar documento Comisión sobre Saldo Administrado AFP">

